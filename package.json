{
  "name": "strapi-plugin-magic-messagegate",
  "version": "1.0.0",
  "description": "Send template messages over WhatsApp, Telegram and SMS from Strapi 5, with a durable outbox, delivery and read tracking, consent and fallback.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "strapi5",
    "whatsapp",
    "whatsapp-cloud-api",
    "telegram",
    "telegram-bot",
    "sms",
    "messaging",
    "notifications",
    "templates"
  ],
  "license": "MIT",
  "author": "Schero D.",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schero94/Magic-MessageGate.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magic-MessageGate/issues"
  },
  "homepage": "https://schero94.github.io/Magic-MessageGate/",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "strapi-plugin build && node scripts/build-server-bundle.mjs",
    "postbuild": "npm run verify:runtime",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=4 \"tests/*.test.js\"",
    "test:pg": "node --test --test-concurrency=1 \"tests/pg/*.test.js\"",
    "prepack": "npm run build",
    "docs:llms": "node scripts/build-llms-full.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/strapi": "^5.38.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": true
    },
    "@strapi/icons": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.21.0 || >=24.9.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-messagegate",
    "displayName": "Magic MessageGate",
    "description": "Template messages over WhatsApp, Telegram and SMS with delivery tracking"
  }
}
